---
import { getCollection, render } from "astro:content";
import EntryLayout from "../../layouts/EntryLayout.astro";

// Every published entry gets a page, including unlisted ones (which the
// listing pages and llms.txt leave out but which still serve at their URL).
export async function getStaticPaths() {
  const entries = await getCollection("resources", (e) => !(import.meta.env.PROD && e.data.published === false));
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---

<EntryLayout
  title={entry.data.title}
  description={entry.data.description}
  heroImage={entry.data.heroImage}
  heroImageAlt={entry.data.heroImageAlt}
  headings={headings}
  toc={entry.data.toc}
>
  <Content />
</EntryLayout>
