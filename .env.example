# Copy this file to .env for local development, or set these as environment
# variables in CI for production builds (.gitlab-ci.yml sets both).

# Canonical site URL. Used for sitemap generation, llms.txt, and canonical
# link tags.
SITE_URL=https://comp.anu.edu.au

# Base path for subdirectory deployments, with a leading slash: the
# group/project path GitLab Pages serves from. Leave unset for a site served
# from the domain root.
BASE_PATH=/courses/comp3540/
