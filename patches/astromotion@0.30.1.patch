--- a/plugins/remark-deck-bg.ts
+++ b/plugins/remark-deck-bg.ts
@@ -20,7 +20,15 @@ function resolveAssetUrl(url: string, deckPath: string | undefined): string {
   if (!deckPath) return url;
   if (!url.startsWith("./") && !url.startsWith("../")) return url;
   const absPath = resolve(dirname(deckPath), url);
-  const srcIdx = absPath.indexOf("/src/");
+  // Strip the project root when it is known, so a checkout that itself lives
+  // under a directory called `src` (e.g. ~/src/project) still maps
+  // <root>/src/decks/assets/x.jpg to /src/decks/assets/x.jpg. Fall back to
+  // the last `/src/` segment when the root was not recorded.
+  const root = buildState.root.replace(/\/$/, "");
+  if (root && absPath.startsWith(root + "/")) {
+    return withBase(absPath.slice(root.length), buildState.base);
+  }
+  const srcIdx = absPath.lastIndexOf("/src/");
   if (srcIdx === -1) return url;
   return withBase(absPath.slice(srcIdx), buildState.base);
 }
